# Local development configuration shared by the web app (Next.js) and the runner (Python).
# Copy to .env (dev.sh does this automatically on first run).

# Where runtime state lives (SQLite files). Relative to keel/.
KEEL_DATA_DIR=.data

# Fake Box (local stand-in for the Box API, served by the web app)
FAKEBOX_SERVICE_TOKEN=dev-service-account-token
FAKEBOX_WEBHOOK_PRIMARY_KEY=dev-primary-signature-key
FAKEBOX_WEBHOOK_SECONDARY_KEY=dev-secondary-signature-key
FAKEBOX_DL_SECRET=dev-download-url-secret

# Runner (local stand-in for Lambda + SQS FIFO + DynamoDB)
KEEL_BOX_API_BASE=http://127.0.0.1:3000/fakebox/api/2.0
KEEL_BOX_UPLOAD_BASE=http://127.0.0.1:3000/fakebox/upload/2.0
KEEL_BOX_TOKEN=dev-service-account-token
KEEL_WEBHOOK_PRIMARY_KEY=dev-primary-signature-key
KEEL_WEBHOOK_SECONDARY_KEY=dev-secondary-signature-key
KEEL_RUNNER_PORT=8787
KEEL_APP_URL=http://localhost:3000
KEEL_PACKS_DIR=packs
# Seconds between reconciliation sweeps (stand-in for EventBridge Scheduler). 0 disables.
KEEL_RECONCILE_SECONDS=30
# Artificial think time for the offline judge so the UI shows a running state (seconds).
KEEL_OFFLINE_JUDGE_DELAY=2.5

# Judge: "offline" (deterministic, no network) or "bedrock" (Strands + Amazon Bedrock).
KEEL_JUDGE=offline
KEEL_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1
