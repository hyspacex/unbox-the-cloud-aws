{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keel",
  "version": "0.1.0",
  "identifier": "org.hyspacex.keel-widget",
  "build": {
    "beforeDevCommand": "node scripts/prepare-ui.cjs",
    "beforeBuildCommand": "node scripts/prepare-ui.cjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Keel",
        "url": "widget.html",
        "width": 236,
        "height": 122,
        "minWidth": 8,
        "minHeight": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["keel"]
      }
    }
  }
}
