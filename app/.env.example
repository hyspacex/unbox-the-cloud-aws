# Copy to .env.local only on the integration machine. Never commit actual values.
MOCK_MODE=true
KEEL_BASE_URL=http://127.0.0.1:3100
KEEL_PROJECT_ID=lantern
NEXT_TELEMETRY_DISABLED=1

# Live sign-in uses an OAuth 2.0 Box application. Register the exact callback:
# https://your-keel-origin/api/auth/box/callback
BOX_OAUTH_CLIENT_ID=
BOX_OAUTH_CLIENT_SECRET=

# Live background evaluation uses server-side Box authentication:
# short-lived developer token OR an admin-authorized CCG service account.
BOX_DEVELOPER_TOKEN=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=
BOX_FOLDER_ID=
BOX_METADATA_TEMPLATE_KEY=keelReview
BOX_METADATA_SCOPE=enterprise

# Named tenant members; reviewer must not be the author.
KEEL_REVIEWER_LOGIN=
KEEL_AUTHOR_LOGIN=
KEEL_EXTRA_REVIEWER_LOGINS=

# Default AWS SDK credential chain. Do not place AWS credentials in client code.
AWS_REGION=us-east-1
AWS_PROFILE=
KEEL_INFERENCE_PROFILE=us.anthropic.claude-sonnet-4-6

# Optional local input gate. Empty is shown as omitted, not as a successful check.
DECIDER_URL=
