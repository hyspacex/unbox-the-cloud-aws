{
  "name": "keel-desktop-widget",
  "version": "1.0.0",
  "description": "Compact evidence-review widget using the operating system WebView",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "build": "tauri build --no-bundle",
    "bundle": "tauri build",
    "prepare:ui": "node scripts/prepare-ui.cjs",
    "fixture:sync": "node scripts/sync-fixture.cjs",
    "test": "node --test tests/widget.test.cjs",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "keywords": [
    "box",
    "aws",
    "compliance",
    "desktop-widget",
    "windows",
    "macos"
  ],
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
